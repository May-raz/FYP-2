
# Backend Configuration
# Chat replies use Groq (free tier): https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_key_here
# Optional Groq fallback key (used if primary fails/rate-limits)
# GROQ_API_KEY_BACKUP=gsk_your_second_groq_key_here
# Optional: override model (default is llama-3.1-8b-instant)
# GROQ_MODEL=llama-3.1-8b-instant
# Optional Grok/xAI fallback
# GROK_API_KEY=xai-your_grok_key_here
# GROK_MODEL=grok-2-latest
# Optional Hugging Face fallback (router)
# HUGGINGFACE_API_KEY=hf_your_hf_token_here
# HF_CHAT_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Optional: seconds to wait on LanguageTool before falling back (Windows can be slow)
# GRAMMAR_CHECK_TIMEOUT_SEC=25

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
FLASK_APP=complete_english_tutor.py

# JWT Secret (change this in production). If you change it, everyone must log in again.
JWT_SECRET_KEY=english-tutor-secret-key-2025
# Access token lifetime in days (library default is 15 minutes without this)
JWT_ACCESS_TOKEN_DAYS=7

# MongoDB auth storage (signup/login)
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=english_tutor

# Frontend Configuration (for React)
REACT_APP_API_URL=http://localhost:5000

# Optional: comma-separated allowed browser origins for CORS (defaults cover CRA/Vite on :3000 and :5173)
# CORS_ORIGINS=http://localhost:3000