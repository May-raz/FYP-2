# MongoDB (Atlas: Database → Connect → Drivers; use user + URL-encoded password)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/fluency_engine?retryWrites=true&w=majority&appName=Cluster0

# Same value as backend/.env JWT_SECRET_KEY
JWT_SECRET_KEY=english-tutor-secret-key-2025

PORT=5000
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
