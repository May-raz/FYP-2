# JWT secret used by Node tutor + gamification APIs
JWT_SECRET_KEY=english-tutor-secret-key-2025

PORT=5001
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/?retryWrites=true&w=majority
# MONGO_DB_NAME=english_tutor
# OpenAI API for tutor chat + speech-to-text
# OPENAI_API_KEY=sk-xxx
# OPENAI_MODEL=gpt-4o-mini

# ElevenLabs Text-to-Speech (required for character voices)
# ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Demo seed (optional): npm run seed:demo
# DEMO_SEED_SECRET=speakwise-demo-2025

# Production CORS — include your Vercel frontend URL
# FRONTEND_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
# Optional: override default voice IDs (see src/config/voiceConfig.ts)
# ELEVENLABS_VOICE_EMMA=21m00Tcm4TlvDq8ikWAM
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5
