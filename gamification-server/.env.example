# JWT — required in production (min 32 characters)
JWT_SECRET_KEY=

PORT=5001
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# MongoDB — required
MONGO_URI=
MONGO_DB_NAME=english_tutor

# OpenAI — chat, emotion inference, STT, pronunciation coaching
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs — text-to-speech for tutor voices
ELEVENLABS_API_KEY=

# Optional: admin demo seed endpoint (npm run seed:demo)
# DEMO_SEED_SECRET=

# Production CORS — include your deployed frontend URL
# FRONTEND_ORIGIN=http://localhost:3000,https://your-frontend.vercel.app
